{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Expo Light",
  "author": "Manual conversion from VS Code Expo Light",
  "themes": [
    {
      "name": "Expo Light",
      "appearance": "light",
      "style": {
        "editor.background": "#ffffff",
        "editor.foreground": "#1c2024",
        "editor.line_number": "#8b8d98",
        "editor.active_line_number": "#1c2024",
        "editor.selection.background": "#cdced6",
        "editor_gutter.background": "#f0f0f3",
        "tab_bar.background": "#f0f0f3",
        "tab.active_background": "#fcfcfd",
        "tab.inactive_background": "#f0f0f3",
        "border": "#d9d9e0",
        "border.focused": "#0588f0",
        "status_bar.background": "#fcfcfd",
        "title_bar.background": "#f0f0f3",
        "sidebar.background": "#fcfcfd",
        "panel.background": "#fcfcfd",
        "scrollbar.thumb.background": "#e8e8ec",
        "scrollbar.thumb.hover_background": "#e0e1e6",
        "syntax": {
          "comment": "#80838d",
          "constant": "#cf3897",
          "constant.numeric": "#ab6400",
          "string": "#c07f00",
          "keyword": "#8145b5",
          "function": "#0588f0",
          "type": "#2b9a66",
          "variable": "#1c2024",
          "variable.parameter": "#0588f0",
          "property": "#0588f0",
          "punctuation": "#8b8d98",
          "operator": "#80838d",
          "constructor": "#0588f0",
          "tag": "#f76b15",
          "attribute": "#dc3e42",
          "number": "#ab6400"
        }
      }
    }
  ]
}