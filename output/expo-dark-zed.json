{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Expo Dark",
  "author": "Manual conversion from VS Code Expo Dark",
  "themes": [
    {
      "name": "Expo Dark",
      "appearance": "dark",
      "style": {
        "editor.background": "#111113",
        "editor.foreground": "#edeef0",
        "editor.line_number": "#696e77",
        "editor.active_line_number": "#b0b4ba",
        "editor.selection.background": "#2e3135",
        "editor_gutter.background": "#0c0d0e",
        "tab_bar.background": "#0c0d0e",
        "tab.active_background": "#18191b",
        "tab.inactive_background": "#0c0d0e",
        "border": "#212225",
        "border.focused": "#70b8ff",
        "status_bar.background": "#0c0d0e",
        "title_bar.background": "#0c0d0e",
        "sidebar.background": "#0c0d0e",
        "panel.background": "#0c0d0e",
        "scrollbar.thumb.background": "#212225",
        "scrollbar.thumb.hover_background": "#272a2d",
        "syntax": {
          "comment": "#777b84",
          "constant": "#de51a8",
          "constant.numeric": "#ffca16",
          "string": "#ffca16",
          "keyword": "#9a5cd0",
          "function": "#3b9eff",
          "type": "#3dd68c",
          "variable": "#edeef0",
          "variable.parameter": "#3b9eff",
          "property": "#3b9eff",
          "punctuation": "#696e77",
          "operator": "#777b84",
          "constructor": "#3b9eff",
          "tag": "#f76b15",
          "attribute": "#e5484d",
          "number": "#ffca16"
        }
      }
    }
  ]
}